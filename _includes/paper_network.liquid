<section class="paper-network-section" aria-labelledby="paper-network-heading" data-paper-network>
  <div class="paper-network-header">
    <div>
      <h2 id="paper-network-heading">My Project Network</h2>
    </div>
    <div class="paper-network-controls" aria-label="Paper network controls">
      <button class="paper-network-control" type="button" data-network-zoom="out" title="Zoom out" aria-label="Zoom out">-</button>
      <button class="paper-network-control paper-network-zoom-readout" type="button" data-network-zoom="reset" title="Reset zoom to 100%" aria-label="Reset zoom to 100%">100%</button>
      <button class="paper-network-control" type="button" data-network-zoom="in" title="Zoom in" aria-label="Zoom in">+</button>
    </div>
  </div>

  <div class="paper-network-shell">
    <script type="application/json" id="paper-network-data">{{ site.data.paper_network | jsonify }}</script>

    <div class="paper-network-graph-card">
      <div class="paper-network-map-insights" aria-label="Network centrality summary">
        <div class="paper-network-leaderboard">
          <div class="paper-network-map-label">Leaderboard</div>
          <div class="paper-network-leaderboard-modes" aria-label="Choose leaderboard metric">
            <span>Rank by</span>
            <button class="paper-network-leaderboard-mode is-active" type="button" data-network-leaderboard-metric="degree" aria-pressed="true">Degree</button>
            <button class="paper-network-leaderboard-mode" type="button" data-network-leaderboard-metric="connectivity" aria-pressed="false">Connectivity</button>
            <button class="paper-network-leaderboard-mode" type="button" data-network-leaderboard-metric="bridge" aria-pressed="false">Bridge</button>
          </div>
          <div class="paper-network-leaderboard-list" aria-label="Network role leaderboard"></div>
        </div>
        <div class="paper-network-map-definitions" aria-label="Centrality definitions">
          <div class="paper-network-map-definition is-active" data-network-definition-metric="degree">
            <span class="paper-network-map-definition-heading">
              <strong class="paper-network-map-definition-term">Degree</strong>
              <span class="paper-network-map-definition-role">direct reach</span>
            </span>
            <span class="paper-network-map-definition-description">
              <span>Share of other projects with at least one shared feature in the selected layer.</span>
              <span class="paper-network-map-definition-interpretation">Higher means <span class="paper-network-map-definition-emphasis">more neighboring projects</span>.</span>
            </span>
          </div>
          <div class="paper-network-map-definition" data-network-definition-metric="connectivity">
            <span class="paper-network-map-definition-heading">
              <strong class="paper-network-map-definition-term">Connectivity</strong>
              <span class="paper-network-map-definition-role">average similarity</span>
            </span>
            <span class="paper-network-map-definition-description">
              <span>Average feature-overlap score with all other projects in the selected layer.</span>
              <span class="paper-network-map-definition-interpretation">Higher means <span class="paper-network-map-definition-emphasis">more shared features across the portfolio</span>.</span>
            </span>
          </div>
          <div class="paper-network-map-definition" data-network-definition-metric="bridge">
            <span class="paper-network-map-definition-heading">
              <strong class="paper-network-map-definition-term">Bridge</strong>
              <span class="paper-network-map-definition-role">between-cluster role</span>
            </span>
            <span class="paper-network-map-definition-description">
              <span>Betweenness centrality using similarity as edge strength.</span>
              <span class="paper-network-map-definition-interpretation">Higher means <span class="paper-network-map-definition-emphasis">more between-cluster connections</span>.</span>
            </span>
          </div>
        </div>
      </div>
      <div class="paper-network-legend" aria-label="Similarity edge layer controls">
        <span class="paper-network-legend-note">Edge layers</span>
        <label class="paper-network-layer-toggle paper-network-layer-concepts">
          <input type="checkbox" data-network-layer="concepts" checked>
          <span><i></i>Concept</span>
        </label>
        <label class="paper-network-layer-toggle paper-network-layer-methods">
          <input type="checkbox" data-network-layer="methods" checked>
          <span><i></i>Method</span>
        </label>
        <label class="paper-network-layer-toggle paper-network-layer-domains">
          <input type="checkbox" data-network-layer="domains" checked>
          <span><i></i>Domain</span>
        </label>
        <span class="paper-network-legend-note">Line thickness shows overlap within the selected layer.</span>
      </div>

      <div class="paper-network-graph-frame">
        <svg
          class="paper-network-svg"
          viewBox="0 0 900 520"
          role="img"
          aria-labelledby="paper-network-heading paper-network-caption"
        >
          <g class="paper-network-viewport">
            <g class="paper-network-clusters">
              <rect class="paper-network-zone paper-network-zone-social" x="35" y="20" width="400" height="445" rx="18"></rect>
              <rect class="paper-network-zone paper-network-zone-aiops" x="465" y="20" width="400" height="445" rx="18"></rect>
              <text class="paper-network-zone-label" x="58" y="52">Social Network Analytics and Platform Operations</text>
              <text class="paper-network-zone-label" x="488" y="52">AI and Machine Learning for Operations</text>
            </g>
            <g class="paper-network-edges"></g>
            <g class="paper-network-nodes"></g>
          </g>
        </svg>
      </div>
      <p id="paper-network-caption" class="sr-only">Interactive network linking papers by shared research questions, methods, and application settings.</p>
    </div>

    <aside class="paper-network-detail" aria-live="polite">
      <div class="paper-network-detail-main">
        <div class="paper-network-detail-label">Selected Paper</div>
        <h3 class="paper-network-detail-title">Select a paper</h3>
        <p class="paper-network-detail-meta">Paper details will appear here.</p>
        <p class="paper-network-detail-authors"></p>
        <div class="paper-network-centrality-matrix" aria-label="Selected paper network role"></div>
        <div class="paper-network-detail-features" aria-label="Selected paper features"></div>
      </div>
    </aside>
  </div>
</section>
